#!/usr/bin/env python3
"""aiw — kisiye ait AI calisma altyapisi. Yalnizca stdlib.

Komutlar icin: aiw yardim
"""
import json
import subprocess
import sys
from pathlib import Path

KOK = Path(__file__).resolve().parent
sys.path.insert(0, str(KOK))

ISARET_BAS = "<!-- aiw:bas -->"
ISARET_SON = "<!-- aiw:son -->"
HEDEF_KURAL = Path.home() / ".claude" / "CLAUDE.md"
KAYNAK_KURAL = KOK / "CLAUDE.md"


def surum():
    try:
        c = subprocess.run(["git", "-C", str(KOK), "rev-parse", "--short", "HEAD"],
                           capture_output=True, text=True, timeout=5)
        return c.stdout.strip() or "commit-yok"
    except Exception:
        return "git-yok"


def damga():
    return f"[ai-workbench {surum()}]"


# --- komutlar ---------------------------------------------------------------

def k_models(argv):
    from aiw_lib import gateway
    filtre = argv[0] if argv else ""
    m = [x for x in gateway.modeller() if filtre in x]
    for x in m:
        print(x)
    print(f"\n{len(m)} model {damga()}")


def k_ask(argv):
    """aiw ask <model> <istem> [--dosya YOL]"""
    from aiw_lib import gateway
    if len(argv) < 2:
        print("kullanim: aiw ask <model> <istem> [--dosya YOL]"); return 2
    model, istem = argv[0], argv[1]
    if "--dosya" in argv:
        y = Path(argv[argv.index("--dosya") + 1])
        istem += "\n\n---\n" + y.read_text(encoding="utf-8")
    metin, kayit = gateway.sor(model, istem)
    print(metin)
    bedel = f"{kayit['usd']:.6f} USD" if kayit.get("usd") is not None else "USD bilinmiyor (fiyat tanimsiz)"
    print(f"\n--- {damga()} {model} | token {kayit['token_giris']}/{kayit['token_cikis']}"
          f" | {kayit['saniye']}sn | {bedel}")


def k_check(argv):
    from checks import refs, sizinti
    hedef = Path(argv[0] if argv else ".")
    toplam = 0
    for ad, bulgular in (("refs", [(d, n, f"kirik referans -> {r}") for d, n, r in refs.kos(hedef)]),
                         ("sizinti", sizinti.kos(hedef))):
        for d, n, m in bulgular:
            print(f"{d}:{n}: [{ad}] {m}")
        toplam += len(bulgular)
    print(f"\n{toplam} bulgu {damga()}")
    return 1 if toplam else 0


def k_bench(argv):
    hata = 0
    for olcer in sorted((KOK / "benchmarks").glob("*/olc.py")):
        hata |= subprocess.call([sys.executable, str(olcer)])
    return hata


def k_maliyet(argv):
    """runs/ altindaki cagrilarin token toplami — kanit olmadan tasarruf iddia edilmez."""
    toplam = {}
    for p in (KOK / "runs").rglob("*.json"):
        k = json.loads(p.read_text())
        t = toplam.setdefault(k["model"], {"cagri": 0, "giris": 0, "cikis": 0, "hata": 0,
                                           "usd": 0.0, "fiyatli": 0})
        t["cagri"] += 1
        if k.get("sonuc") == "hata":
            t["hata"] += 1
        t["giris"] += k.get("token_giris") or 0
        t["cikis"] += k.get("token_cikis") or 0
        if k.get("usd") is not None:
            t["usd"] += k["usd"]; t["fiyatli"] += 1
    if not toplam:
        print("kayit yok."); return 0
    print(f"{'model':<38} {'cagri':>6} {'giris':>9} {'cikis':>9} {'hata':>5}  {'USD':>12}")
    bilinmeyen = 0
    for m, t in sorted(toplam.items()):
        if t["fiyatli"] == t["cagri"]:
            usd = f"{t['usd']:.6f}"
        elif t["fiyatli"] == 0:
            usd = "bilinmiyor"; bilinmeyen += t["cagri"]
        else:
            usd = f"{t['usd']:.6f}+?"; bilinmeyen += t["cagri"] - t["fiyatli"]
        print(f"{m:<38} {t['cagri']:>6} {t['giris']:>9} {t['cikis']:>9} {t['hata']:>5}  {usd:>12}")
    genel = sum(t["usd"] for t in toplam.values())
    print(f"\ntoplam bilinen: {genel:.6f} USD")
    if bilinmeyen:
        print(f"fiyati tanimsiz cagri: {bilinmeyen} — 'aiw fiyat' ile kaynagiyla birlikte gir")
    print(f"{damga()}")


def k_fiyat(argv):
    """aiw fiyat                      tabloyu listeler
       aiw fiyat <model> <giris> <cikis> <kaynak>   milyon token basina USD ekler"""
    from aiw_lib import gateway
    d = json.loads(gateway.FIYAT.read_text())
    if not argv:
        f = d.get("fiyatlar", {})
        if not f:
            print("fiyat tablosu bos — hicbir model icin USD hesaplanmiyor.")
        for m, v in sorted(f.items()):
            print(f"{m:<38} giris {v['giris_1m_usd']:>8} | cikis {v['cikis_1m_usd']:>8} | {v['kaynak']} ({v['tarih']})")
        return 0
    if len(argv) < 4:
        print("kullanim: aiw fiyat <model> <giris_1m_usd> <cikis_1m_usd> <kaynak>"); return 2
    from datetime import date
    d["fiyatlar"][argv[0]] = {"giris_1m_usd": float(argv[1]), "cikis_1m_usd": float(argv[2]),
                              "kaynak": " ".join(argv[3:]), "tarih": date.today().isoformat()}
    gateway.FIYAT.write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")
    print(f"eklendi: {argv[0]}")


def k_install(argv):
    """Ortak kurali ~/.claude/CLAUDE.md icindeki yonetilen bloga yazar. Idempotent."""
    if not KAYNAK_KURAL.exists():
        print(f"kaynak yok: {KAYNAK_KURAL}"); return 1
    blok = f"{ISARET_BAS}\n<!-- kaynak: {KAYNAK_KURAL} — elle duzenleme, 'aiw install' ile guncelle -->\n{KAYNAK_KURAL.read_text().strip()}\n{ISARET_SON}"
    HEDEF_KURAL.parent.mkdir(parents=True, exist_ok=True)
    mevcut = HEDEF_KURAL.read_text() if HEDEF_KURAL.exists() else ""
    if ISARET_BAS in mevcut and ISARET_SON in mevcut:
        bas = mevcut.index(ISARET_BAS); son = mevcut.index(ISARET_SON) + len(ISARET_SON)
        yeni = mevcut[:bas] + blok + mevcut[son:]
        eylem = "guncellendi"
    else:
        yeni = (mevcut.rstrip() + "\n\n" + blok + "\n") if mevcut.strip() else blok + "\n"
        eylem = "eklendi"
    HEDEF_KURAL.write_text(yeni)
    print(f"blok {eylem}: {HEDEF_KURAL} {damga()}")


def k_uninstall(argv):
    if not HEDEF_KURAL.exists():
        print("hedef yok."); return 0
    m = HEDEF_KURAL.read_text()
    if ISARET_BAS not in m:
        print("yonetilen blok yok, dokunulmadi."); return 0
    bas = m.index(ISARET_BAS); son = m.index(ISARET_SON) + len(ISARET_SON)
    HEDEF_KURAL.write_text((m[:bas].rstrip() + "\n" + m[son:].lstrip()).strip() + "\n")
    print(f"blok kaldirildi: {HEDEF_KURAL}")


def k_selftest(argv):
    import tempfile
    hata = 0
    print("1) kontrol olcumu")
    hata |= k_bench([])
    print("\n2) install/uninstall idempotentligi (gecici hedefte)")
    global HEDEF_KURAL
    gercek = HEDEF_KURAL
    with tempfile.TemporaryDirectory() as t:
        HEDEF_KURAL = Path(t) / "CLAUDE.md"
        HEDEF_KURAL.write_text("# kullanicinin kendi notu\n")
        k_install([]); k_install([])
        icerik = HEDEF_KURAL.read_text()
        if icerik.count(ISARET_BAS) != 1:
            print("   KALDI: blok cogaldi"); hata |= 1
        k_uninstall([])
        if "kullanicinin kendi notu" not in HEDEF_KURAL.read_text():
            print("   KALDI: kullanici icerigi kayboldu"); hata |= 1
        if ISARET_BAS in HEDEF_KURAL.read_text():
            print("   KALDI: blok temiz silinmedi"); hata |= 1
    HEDEF_KURAL = gercek
    print("\n3) git'e bagli sizinti maddeleri (gecici depoda)")
    from checks import sizinti
    with tempfile.TemporaryDirectory() as t:
        d = Path(t)
        subprocess.run(["git", "-C", str(d), "init", "-q"], check=True)
        (d / ".env").write_text("UPB_API_KEY=aB3dEfGh1jKlMn0pQrStUv\n")
        (d / "package.json").write_text("{}\n")
        (d / "node_modules").mkdir()
        (d / "node_modules" / "x.js").write_text("//\n")
        subprocess.run(["git", "-C", str(d), "add", "-A"], check=True)
        mesajlar = {m for _, _, m in sizinti.kos(d)}
        for beklenen in ("git bu .env dosyasini izliyor",
                         "git node_modules icerigini izliyor",
                         "lock dosyasi yok"):
            if beklenen not in mesajlar:
                print(f"   KALDI: yakalanmadi -> {beklenen}"); hata |= 1
        # dogru kurulumda bulgu olmamali
        (d / ".gitignore").write_text(".env\nnode_modules/\n")
        (d / "package-lock.json").write_text("{}\n")
        subprocess.run(["git", "-C", str(d), "rm", "-r", "-q", "--cached",
                        ".env", "node_modules"], check=True)
        subprocess.run(["git", "-C", str(d), "add", "-A"], check=True)
        kalan = sizinti.kos(d)
        if kalan:
            print(f"   KALDI: duzeltilmis depoda hala bulgu var -> {kalan}"); hata |= 1
    if not hata:
        print("   3 madde yakalandi, duzeltilmis depo temiz")

    print("\n4) gecit erisimi")
    try:
        from aiw_lib import gateway
        print(f"   {len(gateway.modeller())} model gorunuyor")
    except Exception as e:
        print(f"   UYARI: gecide ulasilamadi ({str(e)[:60]}) — isci katmani devre disi, is Claude'da kalir")
    print(f"\n{'GECTI' if not hata else 'KALDI'} {damga()}")
    return hata


def k_version(argv):
    print(damga())


def k_yardim(argv):
    print(__doc__)
    print("""  aiw models [filtre]        gecitteki modelleri listeler
  aiw ask <model> <istem>    tek turluk cagri (--dosya YOL ile dosya ekler)
  aiw check <yol>            checks/ kontrollerini kosar
  aiw bench                  kontrollerin YP/YN oranini olcer
  aiw maliyet                runs/ token ve USD toplami
  aiw fiyat [model g c kaynak]  fiyat tablosu (bos ise USD hesaplanmaz)
  aiw install | uninstall    ortak kurali ~/.claude/CLAUDE.md'ye baglar
  aiw self-test              altyapinin kendi dogrulamasi
  aiw version                etkin commit""")


KOMUTLAR = {"models": k_models, "ask": k_ask, "check": k_check, "bench": k_bench,
            "maliyet": k_maliyet, "fiyat": k_fiyat, "install": k_install, "uninstall": k_uninstall,
            "self-test": k_selftest, "version": k_version, "yardim": k_yardim}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in KOMUTLAR:
        k_yardim([]); sys.exit(0 if len(sys.argv) < 2 else 2)
    sys.exit(KOMUTLAR[sys.argv[1]](sys.argv[2:]) or 0)
